node_modules/
.p3
Mainstats.md
.assets_raw
.venv
repomix-state.*
templates/
# Claude Code: shared config is committed (rules/, settings.json, agents/,
# skills/); everything else under .claude/ stays local (settings.local.json,
# worktrees, the stop-gate cache). A packaged .skill archive is a build copy
# of a skill folder, not a source.
.claude/*
!.claude/rules/
!.claude/settings.json
!.claude/agents/
!.claude/skills/
.claude/skills/**/*.skill
palette_*

# Local-only material (personal notes, art, pasted references) — never tracked
docs-local/

# UML model — a local reading aid, regenerated on demand by its own generator
# (docs/uml/gen-uml.mjs derives the module pages from the real import graph).
# Kept out of the repo so a stale .drawio can never contradict the code.
docs/uml/

# Generated QA artifacts — rebuilt by tools/optimize.mjs and tools/audit-effects.mjs
docs/meta-validation.md
docs/effect-audit.md

# Timing extraction intermediates — multi-MB, and regenerable ONLY from the raw
# asset export in docs-local/ (itself untracked), so committing them would bloat
# the repo without making them reproducible for anyone else. The curated OUTPUT,
# data/actionable-times.json, IS committed: tools/preprocess.mjs reads it to
# stamp real actionableAt values, so the build must not depend on the export.
# Same arrangement as data/forte-data.json. See docs/TIMING_MODEL.md.
data/timing-data.json
data/bullet-timings.json
docs/timing-extraction-report.md

# Python bytecode from the tools/extract/ asset readers.
__pycache__/
*.pyc

# Effect reconciliation against the game ConfigDB — rebuilt by
# tools/extract/reconcile_effects.py, and only from a local fmodel export.
docs/effect-reconciliation.md
